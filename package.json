{
  "name": "@cavokfly/article-preview",
  "version": "0.1.4",
  "description": "Renders your article JSON (title, section, body blocks) into a newspaper-style preview, shared across your React apps.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/cavokfly/article-preview.git"
  },
  "author": "Cavokfly",
  "license": "MIT",
  "homepage": "https://github.com/cavokfly/article-preview",
  "bugs": {
    "url": "https://github.com/cavokfly/article-preview/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "playground": "npm run dev --prefix test"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.2.4",
    "typescript": "^7.0.2"
  }
}
